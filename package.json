{
  "name": "email-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun install",
    "build": "vite build",
    "precheck": "bun install",
    "check": "tsc --noEmit",
    "predev": "bun install",
    "dev": "vite dev",
    "preformat": "bun install",
    "format": "sort-package-json && oxfmt --write",
    "gen": "bun run gen:cf-types && bun run gen:dev-vars",
    "pregen:cf-types": "bun install",
    "gen:cf-types": "wrangler types",
    "gen:dev-vars": "bun run scripts/gen-dev-vars.ts",
    "preknip": "bun install",
    "knip": "knip",
    "prelint": "bun install",
    "lint": "oxlint --fix",
    "pretest": "bun install",
    "test": "vitest run",
    "pretest:watch": "bun install",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "discord-api-types": "0.38.55",
    "html-to-text": "10.0.1",
    "postal-mime": "3.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.3",
    "knip": "6.38.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.141.0",
    "yaml": "2.9.1"
  }
}
