{
  "name": "email-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun install",
    "dev": "vite dev",
    "prebuild": "bun install",
    "build": "vite build",
    "pretest": "bun install",
    "test": "vitest run",
    "pretest:watch": "bun install",
    "test:watch": "vitest",
    "pretypecheck": "bun install",
    "typecheck": "tsc --noEmit",
    "prelint": "bun install",
    "lint": "oxlint --fix",
    "preformat": "bun install",
    "format": "oxfmt",
    "gen": "bun run gen:cf-types && bun run gen:dev-vars",
    "pregen:cf-types": "bun install",
    "gen:cf-types": "wrangler types",
    "gen:dev-vars": "bun run scripts/gen-dev-vars.ts"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "discord-api-types": "0.38.55",
    "html-to-text": "10.0.1",
    "postal-mime": "3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0",
    "yaml": "2.9.1"
  }
}
