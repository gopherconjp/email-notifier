{
  "name": "email-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "dev": "vite dev",
    "format": "sort-package-json && oxfmt --write",
    "gen": "bun run gen:cf-types && bun run gen:dev-vars",
    "gen:cf-types": "wrangler types",
    "gen:dev-vars": "bun run scripts/gen-dev-vars.ts",
    "knip": "knip",
    "lint": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "discord-api-types": "0.38.56",
    "html-to-text": "10.0.1",
    "postal-mime": "4.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.3",
    "knip": "6.39.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "simple-git-hooks": "2.14.0",
    "sort-package-json": "4.0.0",
    "syndep": "0.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.144.0",
    "yaml": "2.9.1"
  },
  "simple-git-hooks": {
    "post-checkout": "bun run syndep-bun",
    "post-merge": "bun run syndep-bun",
    "post-rewrite": "bun run syndep-bun"
  }
}
