# Copy to `.env.yaml` and fill in, then run `bun run gen:dev-vars`. See README.

# username -> Discord webhook URL (username = local part of the recipient).
DISCORD_WEBHOOK_MAP:
  user1: "https://discord.com/api/webhooks/xxxx/yyyy"
  user2: "https://discord.com/api/webhooks/aaaa/bbbb"

# Domain incoming mail is forwarded to.
FORWARD_EMAIL_DOMAIN: "forward.example.com"
