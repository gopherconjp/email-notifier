# Configuration source for the email-notifier Worker.
#
# Copy this file to `.env.yaml` (git-ignored) and fill in real values, then run:
#   bun run gen:dev-vars   # generate `.dev.vars` for local development (vite dev)
#
# Both keys below map 1:1 onto the two values the Worker reads at runtime
# (dev vars locally; Workers secrets in production).

# Map of email username -> Discord webhook URL.
# The username is the local part of the recipient address, e.g. the "user1" in
# "user1@gophercon.jp". Incoming mail for a username listed here is posted to its
# webhook; usernames not listed are forwarded only (no Discord notification).
DISCORD_WEBHOOK_MAP:
  user1: "https://discord.com/api/webhooks/xxxx/yyyy"
  user2: "https://discord.com/api/webhooks/aaaa/bbbb"

# Domain that incoming mail is forwarded to. Mail addressed to
# "{username}@gophercon.jp" is forwarded to "{username}@FORWARD_EMAIL_DOMAIN".
FORWARD_EMAIL_DOMAIN: "forward.example.com"
