{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "gitIgnoredAuthors": ["114827586+autofix-ci[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Auto merge all dependencies",
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "No minimum release age for gopherconjp/*",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "0 days",
      "matchPackageNames": [
        "gopherconjp/{/,}**"
      ]
    }
  ]
}
